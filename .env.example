# 复制本文件为 .env 后按需修改，再执行 docker compose 相关命令即生效。
# 不创建 .env 时，compose 使用「官方 Docker Hub」基础镜像，也能直接运行。

# ---- 对外端口 ----
WEB_PORT=80

# ---- 镜像仓库前缀（国内网络一行切换镜像站）----
# 留空 = 官方 Docker Hub（海外 / GitHub Actions CI 的默认）。
# 国内拉不动官方镜像时，取消下面这行注释即可整体切换：
#   REGISTRY_PREFIX=docker.m.daocloud.io/library/
# 也可换成其它可用仓库，例如 docker.1ms.run/library/ 。
# 注意：前缀必须以 / 结尾，并指向该镜像站的 /library/ 路径。
REGISTRY_PREFIX=

# ---- 数据库 ----
# 数据库名（后端 JDBC url 与 MYSQL_DATABASE 保持一致）
MYSQL_DATABASE=fileshare
# 应用连库账号（生产务必改强密码）
MYSQL_USER=fileshare
MYSQL_PASSWORD=fileshare_pass
# root 口令（仅容器内管理用，生产务必改强密码）
MYSQL_ROOT_PASSWORD=fileshare_root
