# =============================================================================
# 仓库根 .gitignore
# =============================================================================

# ---- 环境变量 / 密钥：绝对不要提交 ----
# .env 里含数据库口令等敏感信息；.env.example 是模板，必须保留在版本控制中。
.env
.env.*
!.env.example

# ---- Docker Compose 本地覆盖文件（个人机器专用，不提交） ----
docker-compose.override.yml
docker-compose.override.yaml

# ---- 运行时数据 / 用户上传文件（只进命名卷，不进版本库） ----
fileshare_server/data/

# ---- 学习笔记 / 参考文档（不公开） ----
/docs/

# ---- 日志 ----
*.log

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
